#: templates/settings.php:468
msgid "Download Sync Log"
msgstr "Descargar el registro de sincronización"

#: templates/settings.php:472
msgid "Cancellation stops remaining work. Data already sent to Sender is kept."
msgstr "La cancelación detiene el trabajo pendiente. Se conservan los datos ya enviados a Sender."

#: templates/settings.php:481
msgid "Store update"
msgstr "Actualización de la tienda"

#: templates/settings.php:483
msgid "Keeps existing store data compatible with this plugin version."
msgstr "Mantiene la compatibilidad de los datos existentes de la tienda con esta versión del plugin."

#: templates/settings.php:493
