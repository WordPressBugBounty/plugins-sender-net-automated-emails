#: templates/settings.php
msgid "Sync stopped before completion. Check the sync log and try again."
msgstr "La sincronización se ha detenido antes de finalizar. Consulta el registro de sincronización e inténtalo de nuevo."

#: templates/settings.php
msgid "Sync could not start. Reload this page to try again."
msgstr "No se ha podido iniciar la sincronización. Recarga esta página para volver a intentarlo."

#: templates/settings.php
msgid "Download the sync log to check progress or troubleshoot issues."
msgstr "Descarga el registro de sincronización para consultar el progreso o investigar problemas."

#: templates/settings.php
msgid "Cancel sync"
msgstr "Cancelar sincronización"

#: templates/settings.php
msgid "Cancelling sync. Waiting for the worker to stop before another sync can start."
msgstr "Cancelando la sincronización. Esperando a que se detenga el proceso antes de iniciar otra sincronización."

#: templates/settings.php
msgid "Sync cancelled. Data already sent to Sender has been kept."
msgstr "Sincronización cancelada. Se han conservado los datos ya enviados a Sender."

#: templates/settings.php
msgid "Could not request cancellation. Please try again."
msgstr "No se ha podido solicitar la cancelación. Inténtalo de nuevo."

#: templates/settings.php
msgid "Cancellation stops remaining work. Data already sent to Sender is kept."
msgstr "La cancelación detiene el trabajo pendiente. Se conservan los datos ya enviados a Sender."

